{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockly Games",
  "version": "0.1.0",
  "identifier": "com.blocklygames.offline",
  "build": {
    "beforeDevCommand": "node scripts/download-blockly.mjs",
    "beforeBuildCommand": "node scripts/download-blockly.mjs --force",
    "frontendDist": "../site"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Blockly Games",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright 2014 Google LLC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE"
    }
  }
}
